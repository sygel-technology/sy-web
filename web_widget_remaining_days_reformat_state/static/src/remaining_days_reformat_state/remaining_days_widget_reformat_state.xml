<templates xml:space="preserve">
    <t
        t-name="web_widget_remaining_days_reformat_state.RemainingDaysFieldReformatState"
    >
        <t t-if="props.readonly">
            <t t-set="days" t-value="diffDays" />
            <t t-set="formatted" t-value="formattedValue" />
            <div t-att-class="cssClass" t-att-title="formatted">
                <t t-out="diffString" />
            </div>
        </t>
        <t t-else="">
            <DateTimeField t-props="props" />
        </t>
    </t>
</templates>
